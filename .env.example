# ══════════════════════════════════════════════════════════════
#  Instagram × Shopee Affiliate Automation — Configuração
#  Copie para .env e preencha com seus valores reais
#  Para testar sem credenciais reais: ative os modos de teste
# ══════════════════════════════════════════════════════════════

# ─── Modos de Teste (mude para false em produção) ────────────
SHOPEE_TEST_MODE=true        # true = usa produtos de exemplo
HIGGSFIELD_TEST_MODE=true    # true = usa vídeo de demonstração
META_TEST_MODE=true          # true = simula publicação (não publica)

# ─── Shopee Open API (Afiliados BR) ──────────────────────────
SHOPEE_APP_ID=seu_app_id_aqui
SHOPEE_APP_SECRET=seu_app_secret_aqui
SHOPEE_ACCESS_TOKEN=seu_access_token_aqui
SHOPEE_BASE_URL=https://open-api.affiliate.shopee.com.br

# Filtros de produto
SHOPEE_MIN_COMMISSION=8            # Comissão mínima em %
SHOPEE_MAX_PRODUCTS_PER_RUN=10     # Máximo de produtos por execução
SHOPEE_CATEGORY_IDS=               # Opcional: "100001,100002"

# ─── Higgsfield AI ───────────────────────────────────────────
HIGGSFIELD_API_KEY=seu_api_key_higgsfield
HIGGSFIELD_WEBHOOK_SECRET=uma_string_secreta_qualquer

# ─── Meta Graph API (Instagram Business) ─────────────────────
META_ACCESS_TOKEN=seu_long_lived_page_access_token
META_INSTAGRAM_ACCOUNT_ID=seu_instagram_business_account_id
META_APP_ID=seu_meta_app_id
META_APP_SECRET=seu_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=token_verificacao_webhook_meta

# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost              # "db" se usar docker-compose
DB_PORT=5432
DB_NAME=shopee_automation
DB_USER=shopee_bot
DB_PASSWORD=troque_esta_senha_aqui

# ─── Servidor ─────────────────────────────────────────────────
PORT=3457
# IMPORTANTE: deve ser HTTPS em produção para o Instagram aceitar o vídeo
# Com docker-compose local: http://SEU_IP_PUBLICO:3457
# Com nginx + certbot:      https://SEU_DOMINIO.com
PUBLIC_BASE_URL=https://SEU_DOMINIO.com
WEBHOOK_PATH=/webhook/higgsfield

# ─── Vídeo ────────────────────────────────────────────────────
VIDEO_FORMAT=reels             # reels (9:16) | feed (1:1)
VIDEO_DURATION_MAX=30          # segundos
WATERMARK_PATH=assets/logo.png # Deixe vazio se não tiver logo
MUSIC_PATH=assets/music/bg.mp3 # Deixe vazio se não tiver música

# ─── Post / Afiliado ──────────────────────────────────────────
AFFILIATE_HASHTAGS=#shopee #oferta #promocao #comprinhas #lojaonline #desconto
AFFILIATE_CTA=🔗 Link na bio!

# ─── Claude AI (captions e narração) ──────────────────────────
# Obtido em: console.anthropic.com
ANTHROPIC_API_KEY=             # Deixe vazio para usar templates
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # Haiku = rápido e barato

# ─── Edge TTS (narração gratuita) ─────────────────────────────
# Instale com: pip install edge-tts
TTS_ENABLED=true               # false = desativa narração
TTS_VOICE=pt-BR-FranciscaNeural   # ou pt-BR-AntonioNeural, pt-BR-ThalitaNeural
TTS_RATE=+10%                  # velocidade (+10% = levemente mais rápido)

# ─── muapi.ai (fallback de geração de vídeo) ──────────────────
# Alternativa ao Higgsfield — 60+ modelos (Kling, Veo, etc.)
# Obtido em: muapi.ai
MUAPI_API_KEY=                 # Deixe vazio para não usar
MUAPI_MODEL=kling-image2video-v1-6-standard

# ─── Pexels / Pixabay (imagens e B-roll gratuitos) ────────────
# Pexels: pexels.com/api  |  Pixabay: pixabay.com/api/docs
PEXELS_API_KEY=                # Usado quando produto não tem imagem
PIXABAY_API_KEY=               # Fallback do Pexels

# ─── Logs ─────────────────────────────────────────────────────
LOG_LEVEL=info                 # debug | info | warn | error
NODE_ENV=production
