# ─── Shopee Open API ─────────────────────────────────────────────────────────
SHOPEE_APP_ID=your_app_id
SHOPEE_APP_SECRET=your_app_secret
SHOPEE_ACCESS_TOKEN=your_access_token
SHOPEE_BASE_URL=https://open-api.affiliate.shopee.com.br

# Filtros de produto
SHOPEE_MIN_COMMISSION=8
SHOPEE_CATEGORY_IDS=                 # Opcional: "100001,100002" (separado por vírgula)
SHOPEE_MAX_PRODUCTS_PER_RUN=10

# ─── Higgsfield AI ───────────────────────────────────────────────────────────
HIGGSFIELD_API_KEY=your_higgsfield_api_key
HIGGSFIELD_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Meta Graph API (Instagram) ──────────────────────────────────────────────
META_ACCESS_TOKEN=your_long_lived_page_access_token
META_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopee_automation
DB_USER=shopee_bot
DB_PASSWORD=your_db_password

# ─── Servidor / Webhooks ─────────────────────────────────────────────────────
PORT=3457
PUBLIC_BASE_URL=https://SEU_DOMINIO.com
WEBHOOK_PATH=/webhook/higgsfield

# ─── Configurações de Vídeo ──────────────────────────────────────────────────
VIDEO_FORMAT=reels              # reels | feed
VIDEO_DURATION_MAX=30           # segundos
WATERMARK_PATH=assets/logo.png  # Opcional
MUSIC_PATH=assets/music/bg.mp3  # Opcional

# ─── Afiliado ────────────────────────────────────────────────────────────────
AFFILIATE_HASHTAGS=#shopee #oferta #promocao #comprinhas #lojaonline
AFFILIATE_CTA=🔗 Link na bio!

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
